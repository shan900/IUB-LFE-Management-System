<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="500" prefWidth="600" spacing="15" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.iub_lfe_management.shan.CheckEligibilityController">

    <padding>
        <Insets bottom="25" left="35" right="35" top="25" />
    </padding>

    <Label style="-fx-font-size: 23px; -fx-font-weight: bold;" text="IUB LFE Management System" />

    <Label style="-fx-font-size: 19px; -fx-text-fill: #2563eb;" text="Check LFE Eligibility" />

    <TextField fx:id="studentIdField" maxWidth="300" promptText="Enter Student ID" />

    <Button onAction="#searchStudent" prefWidth="180" text="Search Student" />

    <Label fx:id="idLabel" text="Student ID: -" />
    <Label fx:id="nameLabel" text="Student Name: -" />
    <Label fx:id="departmentLabel" text="Department: -" />
    <Label fx:id="creditsLabel" text="Total Credits: -" />

    <Label fx:id="eligibilityLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Eligibility: Not checked" textFill="#ce0505" />

    <Button onAction="#goBack" prefWidth="180" text="Back to Dashboard" />

</VBox>
